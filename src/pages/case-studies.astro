---
import { getCollection } from "astro:content"
import { Image } from "astro:assets"
import BaseLayout from "../layouts/BaseLayout.astro"

const caseStudies = await getCollection("case-studies")

const seoProps = {
    title: "Case Studies | DEVGO Studio",
    description:
        "Explore our portfolio of successful projects and see how we help businesses achieve their goals.",
    type: "website" as const,
}

const isProd = import.meta.env.PROD
---

<BaseLayout seo={seoProps}>
    <section
        id='top'
        class='relative mt-11 md:mt-13 pt-10 md:pt-20 pb-4 md:pb-10 w-full px-2 md:px-6 overflow-hidden opacity-0'
    >
        <div
            class='particle-container absolute inset-0 -z-1'
            id='particles-wrapper'
        >
            <canvas
                id='particle-canvas'
                class='w-full h-full'
                aria-hidden='true'
            ></canvas>
            <div
                class='absolute bg-linear-to-t from-bg from-0% to-50% to-transparent w-full h-full top-0 left-0'
            >
            </div>
        </div>
        <h1
            class='relative text-3xl md:text-5xl lg:text-7xl font-head uppercase'
        >
            Case Studies
        </h1>
    </section>

    <section
        id='case-studies'
        class='grid grid-cols-1 md:grid-cols-2 border-t border-bg-secondary opacity-0'
    >
        {
            caseStudies
                .filter((entry) => isProd ? !entry.filePath?.includes("/example.mdx") : true)
                .map((entry, idx) => (
                    <a
                        href={`/case-studies/${entry.id.replace(/\.(md|mdx)$/, "")}`}
                        class={`relative overflow-clip group p-6 border-bg-secondary opacity-0 border-b ${idx % 2 === 0 ? "md:border-r" : ""}`}
                    >
                        <div class='aspect-video relative overflow-hidden'>
                            {entry.data.image ? (
                                <Image
                                    src={entry.data.image}
                                    alt={entry.data.title}
                                    width={1920}
                                    height={1080}
                                    loading='lazy'
                                    decoding='async'
                                    class='w-full h-full object-contain md:blur-xs group-hover:blur-none transition-all'
                                />
                            ) : (
                                <div class='w-full h-full bg-linear-to-br from-gray-700 to-gray-900' />
                            )}
                            <div class='absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent' />
                        </div>
                        <div class='absolute w-full h-full bottom-0 left-0 p-4 flex flex-col justify-end mix-blend-difference text-white'>
                            <h2 class='font-head text-sm md:text-xl uppercase'>
                                {entry.data.title}
                            </h2>
                            <span class='font-bold text-xs md:text-sm opacity-80'>
                                {entry.data.year} — {entry.data.category}
                            </span>
                        </div>
                    </a>
                ))
        }
    </section>
</BaseLayout>

<script>
    import { animate, onScroll, utils } from "animejs"
    import { WaveParticleBg } from "../lib/engines/wave-particle-bg"
    import { getAnimationManager } from "../lib/engines/animation-manager"

    const manager = getAnimationManager()
    const prefersReducedMotion = manager.getReducedMotion()
    if (!prefersReducedMotion) {
        // Header
        animate("#top", {
            opacity: [0, 1],
            ease: "outQuad",
            delay: 500,
        })

        // Case Study Cards
        animate("#case-studies", {
            opacity: [0, 1],
            delay: 900,
            ease: "outQuad",
        })

        utils.$("#case-studies a").forEach((el) => {
            animate(el, {
                autoplay: onScroll({
                    enter: "90% top",
                }),
                opacity: [0, 1],
                ease: "outQuad",
            })
        })
    } else {
        utils.set("#top, #case-studies, #case-studies a", {
            opacity: 1,
        })
    }

    // Wave Particle Background
    const canvas = document.getElementById("particle-canvas") as HTMLCanvasElement
    const wrapper = document.getElementById("particles-wrapper") as HTMLElement

    if (canvas && wrapper && !prefersReducedMotion) {
        window.addEventListener("load", () => {
            const bg = new WaveParticleBg(canvas, wrapper)
            manager.register("wave-case-studies", bg)
            bg.init()
        })
    }

    // Cleanup on Astro page swap
    document.addEventListener("astro:before-swap", () => {
        manager.destroyAll()
    })
</script>
