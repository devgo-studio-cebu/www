---
import { Image } from "astro:assets"
import BaseLayout from "../layouts/BaseLayout.astro"

const seoProps = {
    title: "Showcase | DEVGO Studio",
    type: "website" as const,
}

import { projects } from "../lib/showcase"
import { Link } from "lucide-astro"

// Sort projects by year (descending) and group by year
const projectsByYear = projects
    .sort((a, b) => b.year - a.year)
    .reduce((acc, project) => {
        const yearGroup = acc.get(project.year) || []
        yearGroup.push(project)
        acc.set(project.year, yearGroup)
        return acc
    }, new Map<number, typeof projects>())

const sortedYears = Array.from(projectsByYear.keys())
---

<BaseLayout seo={seoProps}>
    <section
        id='top'
        class='relative mt-11 md:mt-13 pt-10 md:pt-20 pb-4 md:pb-10 w-full px-2 md:px-6 overflow-hidden opacity-0'
    >
        <div
            class='particle-container absolute inset-0 -z-1'
            id='particles-wrapper'
        >
            <canvas
                id='particle-canvas'
                class='w-full h-full'
                aria-hidden='true'
            ></canvas>
            <div
                class='absolute bg-linear-to-t from-bg from-0% to-50% to-transparent w-full h-full top-0 left-0'
            >
            </div>
        </div>
        <h1
            class='relative text-3xl md:text-5xl lg:text-7xl font-head uppercase'
        >
            Showcase
        </h1>
    </section>

    <section
        id='showcase'
        class='w-full max-w-svw'
    >
        {
            sortedYears.map((year) => {
                const yearProjects = projectsByYear.get(year)
                if (!yearProjects) return null
                return (
                    <div class='showcase-group mb-12 opacity-0'>
                        <h2 class='showcase-year text-2xl md:text-6xl font-head font-extrabold tracking-wide'>
                            {year}
                        </h2>
                        <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6'>
                            {yearProjects.map((project) => {
                                if (project.url)
                                    return (
                                        <a
                                            href={project.url}
                                            target='_blank'
                                            rel='noopener noreferrer'
                                            class='showcase-item w-full h-full relative group opacity-0'
                                        >
                                            <Image
                                                src={project.image}
                                                alt={project.title}
                                                width={1920}
                                                height={1080}
                                                loading='lazy'
                                                decoding='async'
                                                class='w-full h-full object-cover'
                                            />
                                            <p class='absolute bottom-0 left-0 right-0 text-3xl font-head uppercase p-4 pt-10 bg-linear-to-t from-bg to-transparent group-hover:opacity-0 transition-opacity'>
                                                <span class='mix-blend-difference'>
                                                    {project.title}
                                                </span>
                                            </p>
                                            <div class='absolute z-1 bg-primary w-full h-full bottom-0 left-0 mix-blend-lighten flex items-center justify-center group-hover:opacity-100 transition-opacity opacity-0'>
                                                <span class='font-bold text-4xl md:text-2xl uppercase flex flex-row flex-nowrap items-center gap-2'>
                                                    Visit Project
                                                    <Link class='stroke-3 h-10 w-10 md:h-6 md:w-6 stroke-accent' />
                                                </span>
                                            </div>
                                        </a>
                                    )

                                return (
                                    <div class='showcase-item w-full h-full relative group opacity-0'>
                                        <Image
                                            src={project.image}
                                            alt={project.title}
                                            width={1920}
                                            height={1080}
                                            loading='lazy'
                                            decoding='async'
                                            class='w-full h-full object-cover'
                                        />
                                        <p class='absolute bottom-0 left-0 right-0 text-3xl font-head uppercase p-4 pt-10 bg-linear-to-t from-bg to-transparent'>
                                            <span class='mix-blend-difference'>
                                                {project.title}
                                            </span>
                                        </p>
                                    </div>
                                )
                            })}
                        </div>
                    </div>
                )
            })
        }
    </section>
</BaseLayout>

<script>
    import { animate, onScroll, stagger, utils } from "animejs"
    import { WaveParticleBg } from "../lib/engines/wave-particle-bg"
    import { getAnimationManager } from "../lib/engines/animation-manager"

    const manager = getAnimationManager()
    const prefersReducedMotion = manager.getReducedMotion()
    if (!prefersReducedMotion) {
        // Header
        animate("#top", {
            opacity: [0, 1],
            ease: "outQuad",
            delay: 500,
        })

        // Showcase Items
        utils.$(".showcase-group").forEach((group) => {
            animate([group, group.querySelectorAll(".showcase-item")], {
                autoplay: onScroll({
                    enter: "90% top",
                    target: group,
                }),
                opacity: [0, 1],
                delay: stagger(300),
            })
        })
    } else {
        utils.set("#top", { opacity: 1 })
        utils.set([utils.$(".showcase-group"), utils.$(".showcase-item")], {
            opacity: 1,
        })
    }

    // Wave Particle Background
    const canvas = document.getElementById("particle-canvas") as HTMLCanvasElement
    const wrapper = document.getElementById("particles-wrapper") as HTMLElement

    if (canvas && wrapper && !prefersReducedMotion) {
        window.addEventListener("load", () => {
            const bg = new WaveParticleBg(canvas, wrapper)
            manager.register("wave-showcase", bg)
            bg.init()
        })
    }

    // Cleanup on Astro page swap
    document.addEventListener("astro:before-swap", () => {
        manager.destroyAll()
    })
</script>
