---
import { Image } from "astro:assets"

const logoFiles = import.meta.glob("/src/assets/logos/*", { eager: true })
const logos = Object.values(logoFiles).map((mod: any) => mod.default)
---

<section
    id='top'
    class='w-full h-svh relative flex flex-col justify-end py-8 items-center'
>
    <h2 class='text-sm md:text-lg uppercase mb-12 opacity-80 text-center mx-6'>
        Your digital space, built for a life in motion
    </h2>

    <div
        class='logo-infinite-scroll opacity-0 w-full overflow-hidden mask-[linear-gradient(to_right,transparent,black_15%,black_85%,transparent)]'
    >
        <div
            class='logo-scroll-track flex w-max flex-nowrap'
            id='logo-track'
        >
            {
                [...logos, ...logos, ...logos].map((logo) => (
                    <div class='logo-item shrink-0 flex items-center justify-center grayscale opacity-40 pr-12'>
                        <Image
                            src={logo}
                            alt='Partner logo'
                            class='w-auto h-10 md:h-14 object-contain'
                            loading='eager'
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    /* Prevents layout thrashing */
    #logo-track {
        will-change: transform;
    }
</style>

<script>
    import { animate } from "animejs"

    const track = document.getElementById("logo-track")

    window.addEventListener("load", () => {
        if (
            track &&
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
            animate(track, {
                translateX: [0, "-33.33%"],
                duration: 25000,
                ease: "linear",
                loop: true,
            })
        }
    })

    // Intro Animations
    animate("#top h2", {
        opacity: [0, 1],
        translateY: [20, 0],
        ease: "outCubic",
    })

    animate(".logo-infinite-scroll", {
        opacity: [0, 1],
        ease: "outCubic",
        delay: 500,
    })
</script>
