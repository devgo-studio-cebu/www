<section
    id='timeline'
    class='max-w-svw h-svh overflow-x-clip bg-text'
>
    <div class='h-1/2 w-full flex flex-col justify-center'>
        <h2
            id='timeline-header'
            class='font-head font-extrabold text-4xl md:text-8xl flex flex-col uppercase text-bg'
        >
            <span class='opacity-0'>project timeline</span>
            <span class='ml-16 md:ml-48 opacity-0'>estimates</span>
        </h2>
    </div>
    <div class='h-1/2 w-full bg-bg text-text flex flex-col'>

    </div>
</section>
<script>
    import { animate, onScroll, stagger } from "animejs"

    // Header
    animate("#timeline-header span", {
        autoplay: onScroll({
            enter: "90% bottom",
            target: "#timeline-header",
        }),
        opacity: [0, 1],
        translateX: [-100, 0],
        ease: "outCubic",
        delay: stagger(500),
    })
</script>
