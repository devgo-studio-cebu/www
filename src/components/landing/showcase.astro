---
import { Image } from "astro:assets"
import { projects } from "../../lib/projects"
import Project from "./showcase/project.astro"
---

<section
    id='showcase'
    class='max-w-svw overflow-x-clip bg-text text-bg flex flex-col w-full py-10'
>
    <div class='w-full grid grid-cols-2 gap-4 px-4'>
        <!-- left -->
        <div class='flex flex-col gap-4'>
            {
                projects.map((proj, idx) => {
                    if (idx % 2 === 0)
                        return (
                            <Project
                                title={proj.title}
                                image={proj.image}
                                url={proj.url}
                            />
                        )
                })
            }
        </div>
        <!-- right -->
        <div class='flex flex-col gap-4 pt-24 md:pt-0'>
            <h2
                id='showcase-header'
                class='font-head font-extrabold text-6xl md:flex flex-col uppercase text-bg py-14 hidden'
            >
                showcase
            </h2>
            {
                projects.map((proj, idx) => {
                    if (idx % 2 !== 0)
                        return (
                            <Project
                                title={proj.title}
                                image={proj.image}
                                url={proj.url}
                            />
                        )
                })
            }
        </div>
    </div>
</section>
<script>
    import { animate, onScroll, splitText, stagger, utils } from "animejs"

    // Title
    animate("#showcase-header", {
        autoplay: onScroll({
            enter: "90% bottom",
            target: "#showcase-header",
        }),
        opacity: [0, 1],
        translateX: [100, 0],
        ease: "outCubic",
    })

    // Projects
    utils.$(".showcase-container").forEach((cont) => {
        const id = (cont as HTMLElement).dataset.titleId

        animate(`#${id}`, {
            autoplay: onScroll({
                enter: "90% top",
            }),
            opacity: [0, 1],
            translateY: [50, 0],
            ease: "outExpo",
        })

        const { chars } = splitText(`#${id} p`, { chars: true })
        animate(chars, {
            autoplay: onScroll({
                enter: "90% top",
                target: `#${id}`,
            }),
            opacity: [0, 1],
            translateY: [20, 0],
            delay: stagger(30),
        })
    })
</script>
